<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cold Chain Batches Action -->
    <record id="action_coldchain_batches" model="ir.actions.act_window">
        <field name="name">Active Cold-Chain Batches</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('temp_min_c', '!=', False)]</field>
    </record>

    <!-- Active Transits Action -->
    <record id="action_coldchain_transits" model="ir.actions.act_window">
        <field name="name">Monitored Transits</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('transit_monitoring_state', '!=', False)]</field>
    </record>

</odoo>